.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Sistema operativo
.DS_Store
Thumbs.db

# Artefactos de Windows al copiar desde un entorno compartido
*:Zone.Identifier
:*:Zone.Identifier

# Cache de Vite
.vite/
*.local
